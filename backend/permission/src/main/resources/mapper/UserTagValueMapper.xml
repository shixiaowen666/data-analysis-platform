<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.senses.permission.mapper.UserTagValueMapper">

    <!-- 结果映射 -->
    <resultMap id="UserTagValueMap" type="com.senses.permission.entity.UserTagValue">
        <result property="username" column="username" jdbcType="VARCHAR"/>
        <result property="tagId" column="tag_id" jdbcType="BIGINT"/>
        <result property="tagName" column="tag_name" jdbcType="VARCHAR"/>
        <result property="tagValue" column="tag_value" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 根据标签ID删除用户标签值 -->
    <delete id="deleteByTagId" parameterType="java.lang.Long">
        DELETE
        FROM user_tag_values
        WHERE tag_id = #{tagId}
    </delete>

    <delete id="deleteByTagIdAndUsername">
        DELETE
        FROM user_tag_values
        WHERE tag_id = #{tagId} AND username = #{username}
    </delete>
    <select id="selectByUsername" resultType="com.senses.permission.entity.UserTagValue">
        SELECT *
        FROM user_tag_values
        WHERE username = #{username}
    </select>
    <select id="selectByUsernames" resultType="com.senses.permission.entity.UserTagValue">
        SELECT *
        FROM user_tag_values
        WHERE username IN
        <foreach collection="usernames" item="username" open="(" close=")" separator=",">
            #{username}
        </foreach>
    </select>


</mapper>
